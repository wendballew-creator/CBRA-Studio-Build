# cbra_engine.py
from __future__ import annotations

import os
from typing import Any, Dict, List, Literal, Optional

from dotenv import load_dotenv
from openai import OpenAI

load_dotenv()

# Paste your CBRA kernel here (the full CBRA v10.2 text)
CBRA_PROMPT = """
PASTE YOUR CBRA v10.2 KERNEL HERE
""".strip()

# Choose a model you have access to.
# If you're unsure, start with "gpt-4.1".
DEFAULT_MODEL = os.getenv("OPENAI_MODEL", "gpt-4.1")


def _require_api_key() -> str:
    api_key = os.getenv("OPENAI_API_KEY", "").strip()
    if not api_key:
        raise RuntimeError("OPENAI_API_KEY is not set")
    return api_key


def run_cbra(
    user_text: str,
    mode: Literal["production", "debug"] = "production",
    *,
    sources: Optional[List[str]] = None,
    system_identity: str = "CBRA Writing Support (local prototype).",
    model: Optional[str] = None,
) -> Dict[str, Any]:
    """
    Core CBRA execution call.
    - user_text: the user's input
    - mode: production returns only user-facing text; debug returns extra debug fields (if requested by your app)
    - sources: optional list of retrieved source strings (for later retrieval integration)
    """

    if not user_text or not user_text.strip():
        raise ValueError("user_text is empty")

    _require_api_key()
    client = OpenAI()

    sources = sources or []
    model = model or DEFAULT_MODEL

    # Context block: kept simple now; later you can convert sources into structured citations.
    sources_block = ""
    if sources:
        joined = "\n\n---\n\n".join(sources)
        sources_block = f"\n\nSOURCES (field material):\n{joined}\n"

    # Debug request: your main.py can also compute debug locally; this is a minimal hook.
    debug_hint = ""
    if mode == "debug":
        debug_hint = (
            "\n\nDEBUG REQUEST:\n"
            "Return user-facing text, and also return a compact debug object with keys:\n"
            "field_signature, noticing_register, drift_signal, sources_used.\n"
        )

    # Responses API call
    # We keep it minimal: system + developer + user
    # (You can later add tool/retrieval messages or structured input.)
    resp = client.responses.create(
        model=model,
        input=[
            {"role": "system", "content": system_identity},
            {"role": "developer", "content": CBRA_PROMPT},
            {
                "role": "user",
                "content": f"{user_text}{sources_block}{debug_hint}",
            },
        ],
    )

    # Extract text
    text = ""
    try:
        text = resp.output_text or ""
    except Exception:
        text = ""

    result: Dict[str, Any] = {"text": text}

    # Optional: If the model returns JSON in debug mode, your main.py can parse it.
    # We keep the engine output minimal and let main.py decide how to expose debug fields.
    if mode == "debug":
        result["debug"] = {
            "field_signature": "",
            "noticing_register": "",
            "drift_signal": "",
            "sources_used": sources,
        }

    return result
