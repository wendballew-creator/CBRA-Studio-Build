# cbra_engine.py
from __future__ import annotations

import os
import re
from pathlib import Path
from typing import Any, Dict, List, Literal, Optional, Tuple

from dotenv import load_dotenv
from openai import OpenAI

load_dotenv()

# --- Paths ---
CORPUS_DIR = Path(os.getenv("CBRA_CORPUS_DIR", "~/cbra_api/corpus")).expanduser()

# --- CBRA Kernel ---
# Paste your full CBRA v10.2 kernel here or load from corpus file if you prefer.
CBRA_PROMPT = os.getenv("CBRA_KERNEL_TEXT", "").strip() or """
PASTE YOUR CBRA v10.2 KERNEL HERE
""".strip()

# --- Model ---
DEFAULT_MODEL = os.getenv("OPENAI_MODEL", "gpt-4.1")


def _require_api_key() -> str:
    api_key = os.getenv("OPENAI_API_KEY", "").strip()
    if not api_key:
        raise RuntimeError("OPENAI_API_KEY is not set")
    return api_key


def _tokenize(text: str) -> List[str]:
    """
    Tokenize text for retrieval matching.
    - Normalizes unicode (so curly quotes / em-dashes don’t break matches)
    - Normalizes hyphen-like characters to "-"
    - Extracts alphanumeric tokens
    """
    import re
    import unicodedata

    s = unicodedata.normalize("NFKC", text or "")
    s = s.replace("–", "-").replace("—", "-").replace("−", "-")
    s = s.lower()

    # tokens like: intra, active, play, loop, placement
    return re.findall(r"[a-z0-9]+", s)


def retrieve_sources(query: str, k: int = 4) -> Tuple[List[str], List[str], List[Dict[str, Any]]]:
    """
    Returns:
      sources:   list[str] chunks to pass into the model as field material
      citations: list[str] stable refs like "[CBRA_Glossary_v3.md L607+]"
      hits:      list[dict] raw hit objects for debug (file/line/score/snippet/text)
    """
    import re
    import unicodedata

    def _norm(s: str) -> str:
        # Normalize Unicode and hyphen-like chars so "intra-active" == "intra-active"
        s = unicodedata.normalize("NFKC", s or "")
        s = s.replace("-", "-").replace("–", "-").replace("—", "-").replace("−", "-")
        return s.lower()
    query = (query or "").strip()
    if not query:
        return [], [], []

    if not CORPUS_DIR.exists():
        return [], [], []

    EXCLUDE = {"CBRA_Corpus_Index.md"}  # exclude manifest to reduce noise

    terms = _tokenize(query)
    if not terms:
        return [], [], []

    hits: List[Dict[str, Any]] = []

    for md_path in CORPUS_DIR.glob("*.md"):
        if md_path.name in EXCLUDE:
            continue

        boost = 1.0
        # Boost loop file when the query is about placement in the loop
        if any(w in query.lower() for w in ["loop", "sits", "placement", "where"]):
            if md_path.name == "CBRA_Loops_Core.md":
                boost = 4.0

        try:
            text = md_path.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue

    # Placement queries: always include the canonical stage headings from Loops Core
    if placement_query and md_path.name == "CBRA_Loops_Core.md":
        for i, line in enumerate(lines, start=1):
            if re.match(r"^###\s*\d+\.\s+", line.strip()):
                hits.append(
