        except Exception:
            continue

    # Placement queries: always include the canonical stage headings from Loops Core
    if placement_query and md_path.name == "CBRA_Loops_Core.md":
        for i, line in enumerate(lines, start=1):
            if re.match(r"^###\s*\d+\.\s+", line.strip()):
                hits.append(
                    {
                        "file": md_path.name,
                        "line": i,
                        "file": md_path.name,
                        "line": i,
                        "score": 1000.0,  # force inclusion
                        "snippet": line.strip()[:140],
                        "text": line.strip(),
                     }
               )

        # --- STAGE-AWARE BLOCK RETRIEVAL ---
        # --- HEADING-BLOCK RETRIEVAL (with line numbers) ---
        ql = query.lower()
        placement_query = any(w in ql for w in ["loop", "placement", "where", "sits", "between", "stage"])

        # Find each "### ..." heading and slice blocks from it
        headings = list(re.finditer(r"^###\s+.*$", text, flags=re.MULTILINE))
        if not headings:

        for idx, m in enumerate(headings):
            start = m.start()
            end = headings[idx + 1].start() if idx + 1 < len(headings) else len(text)
            block = text[start:end].strip()

            # First line is the heading
            heading_line = block.splitlines()[0].strip()

            # Placement queries prefer numbered stage headings only *in the Loops Core*
            if placement_query and md_path.name == "CBRA_Loops_Core.md":
                if not re.match(r"^###\s*\d+\.\s+", heading_line):
                    continue

            block_tokens = set(_tokenize(block))
            score = 0
            for t in terms:
                if t in block_tokens:
                    score += 1
            if score <= 0:
                continue

            score = float(score) * boost

            # Line number where this block starts (1-indexed)
            start_line = text[:start].count("\n") + 1

            snippet = heading_line
            if len(snippet) > 140:
                snippet = snippet[:140]

            hits.append(
                {
                    "file": md_path.name,
                    "line": start_line,
                    "score": score,
                    "snippet": snippet,
                    "text": block,
                }
            )

    hits.sort(key=lambda h: h["score"], reverse=True)
    top = hits[: max(0, int(k))]

    sources = [h["text"] for h in top]
    citations = [f"[{h['file']} L{h['line']}+]" for h in top]

    return sources, citations, top


def _compress_hits_for_debug(hits: List[Dict[str, Any]], limit: int = 8) -> List[Dict[str, Any]]:
    out = []
    for h in hits[:limit]:
        out.append(
            {
                "file": h.get("file", ""),
                "line": h.get("line", 0),
                "score": h.get("score", 0.0),
                "snippet": h.get("snippet", ""),
            }
        )
    return out


def _local_field_signature(user_text: str, citations: List[str]) -> str:
    # Minimal stable signature: intent + first couple citations
    intent = (user_text or "").strip().splitlines()[0][:160]
    cited = ", ".join(citations[:2]) if citations else "no_corpus_hits"
    return f"user_intent_headline={intent} | corpus={cited}"


def _local_noticing_register(user_text: str) -> List[str]:
    # Placeholder: you can evolve this into actual noticing heuristics later
    return ["conceptual_operator_work"]


def _local_drift_signal(user_text: str) -> List[str]:
    # Placeholder: you can later implement drift detection heuristics
    return []


def _needs_loop_placement_rule(user_text: str) -> bool:
    q = (user_text or "").lower()
    triggers = [
        "where does",
        "where it sits",
        "where it belongs",
        "placement",
        "in the loop",
        "cbra loop",
        "what phase",
    ]
    return any(t in q for t in triggers)


def run_cbra(
    user_text: str,
    mode: Literal["production", "debug"] = "production",
    *,
    sources: Optional[List[str]] = None,
    system_identity: str = "CBRA Writing Support (local prototype).",
    model: Optional[str] = None,
) -> Dict[str, Any]:
    """
    Core CBRA execution call.
    - production: returns only user-facing text
    - debug: returns user-facing text + local debug object (no model-produced debug)
    """
    if not user_text or not user_text.strip():
        raise ValueError("user_text is empty")

    _require_api_key()
    client = OpenAI()
    model = model or DEFAULT_MODEL

    # --- Retrieval ---
    citations: List[str] = []
    raw_hits: List[Dict[str, Any]] = []

    if sources is None:
        sources, citations, raw_hits = retrieve_sources(user_text, k=4)
    else:
        sources = sources or []

    # Labels: stable human-readable labels for debug display only
    retrieval_labels: List[str] = []
    for s in sources:
        first = (s.splitlines()[0].strip() if isinstance(s, str) else str(s))
        retrieval_labels.append(first[:180])

    # --- Field material block (fed into model) ---
    sources_block = ""
    if sources:
        joined = "\n\n---\n\n".join(sources)
        sources_block = f"\n\nSOURCES (field material):\n{joined}\n"

    # --- Placement rule (only when question asks for loop placement) ---
    placement_rule = ""
    if sources and _needs_loop_placement_rule(user_text):
        placement_rule = (
            "\n\nPLACEMENT RULE:\n"
            "When asked where an operator sits in the CBRA loop, describe its placement "
            "relative to canonical loop stages in CBRA_Loops_Core.md using 'between X and Y' language. "
            "Do not claim an operator permeates all stages unless CBRA_Loops_Core.md explicitly defines it that way.\n"
        )

    # --- Output rule (prevents model from printing debug) ---
    output_rule = ""
    if mode == "debug":
        output_rule = (
            "\n\nOUTPUT RULE:\n"
            "Return only the user-facing text. Do not include any debug object, labels, or JSON.\n"
        )

    # --- Call model ---
    resp = client.responses.create(
        model=model,
        input=[
            {"role": "system", "content": system_identity},
            {"role": "developer", "content": CBRA_PROMPT},
            {
                "role": "user",
                "content": f"{user_text}{sources_block}{placement_rule}{output_rule}",
            },
        ],
    )

    text = getattr(resp, "output_text", "") or ""
    result: Dict[str, Any] = {"text": text}

    if mode == "debug":
        result["debug"] = {
            "field_signature": _local_field_signature(user_text, citations),
            "noticing_register": _local_noticing_register(user_text),
            "drift_signal": _local_drift_signal(user_text),
            "sources_used": citations,                 # stable refs
            "retrieval_hits": _compress_hits_for_debug(raw_hits),
            "retrieval_labels": retrieval_labels,      # readable snippets
        }

    return result

