from __future__ import annotations

from typing import Literal

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field

from cbra_engine import run_cbra

app = FastAPI(title="CBRA Writing Support")


class GenerateRequest(BaseModel):
    user_text: str = Field(..., min_length=1)
    mode: Literal["production", "debug"] = "production"


@app.post("/generate")
async def generate(request: GenerateRequest) -> dict:
    user_text = (request.user_text or "").strip()
    if not user_text:
        raise HTTPException(status_code=400, detail="user_text must be non-empty")

    try:
        result = run_cbra(user_text=user_text, mode=request.mode)
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    except RuntimeError as exc:
        # e.g., missing OPENAI_API_KEY
        raise HTTPException(status_code=500, detail=str(exc)) from exc
    except Exception as exc:
        raise HTTPException(status_code=502, detail=f"OpenAI API error: {exc}") from exc

    return result
