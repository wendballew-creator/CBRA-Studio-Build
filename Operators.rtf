\f0\fs24 \cf0 def check_field_resonance(inquiry_text: str, stream_content: str, state) -> float:\
    """\
    Measures the interference pattern between inquiry and stream.\
    Weights core ontology principles higher than standard vocabulary.\
    """\
    inquiry_tokens = set(inquiry_text.lower().split())\
    stream_tokens = set(stream_content.lower().split())\
    overlap = inquiry_tokens & stream_tokens\
    \
    if not overlap:\
        return 0.0\
    \
    # Check resonance against your 'Rules of the Cut' ontology\
    total_resonance = 0.0\
    for token in overlap:\
        # If the token is in your ontology principles, it 'vibrates' more\
        if hasattr(state, 'ontology_ground') and token in state.ontology_ground.principles:\
            total_resonance += 0.25 \
        else:\
            total_resonance += 0.05\
            \
    # Normalize by the 'pressure' of the inquiry\
    return min(1.0, total_resonance / (len(inquiry_tokens) * 0.5))\
\
def apply_intra_action(state, user_text: str) -> None:\
    """Mutates stream participation intensities based on resonance."""\
    for stream in state.streams:\
        resonance = check_field_resonance(user_text, stream.payload.get("text", ""), state)\
        # F(t+1) = F(t) + nudge\
        stream.participation += (resonance * 0.2)\
\
def reintegrate_field(state) -> None:\
    """Softens the field topology when Interpretive Compression is detected."""\
    if state.drift_flags.interpretive_compression:\
        state.field_values.cut_pressure = 0.1\
        state.field_values.cut_permeability = 1.0\
        state.field_values.openness += 0.3\
    \
    # Clear the signal so the engine can try a new 'Cut'\
    state.clear_drift_flags()\
